import random

tag_probabilities = {
    "dog": [("NN", 0.9), ("VB", 0.1)],
    "run": [("VB", 0.8), ("NN", 0.2)],
    "book": [("NN", 0.7), ("VB", 0.3)]
}

words = ["dog", "run", "book"]

for word in words:
    tags = tag_probabilities[word]

    tag_names = [x[0] for x in tags]
    probabilities = [x[1] for x in tags]

    selected = random.choices(tag_names, probabilities)[0]

    print(word, "->", selected)
